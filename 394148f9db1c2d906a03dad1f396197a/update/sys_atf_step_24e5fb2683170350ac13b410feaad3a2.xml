	&#13;
	test.SetResult(true);&#13;
	&#13;
	function TestCase_DeploymentLog(vDeployment,vPayload,vExpected)&#13;
	{&#13;
		function TestCase_DeploymentLog_CheckResult(vInput,vExpected,vResult)&#13;
		{&#13;
			if (vExpected == false)&#13;
