					grDeployment.sys_id,&#13;
					'log')&#13;
					== vExpected);&#13;
			}&#13;
			return false;&#13;
		}&#13;
		&#13;
		test.TestCase(&#13;
			'Function DeploymentLog()',&#13;
			DeploymentLog,&#13;
			{&#13;
				'vDeployment': vDeployment,&#13;
				'vPayload': vPayload&#13;
			},&#13;
			vExpected,&#13;
			TestCase_DeploymentLog_CheckResult);&#13;
	}&#13;
		&#13;
	TestCase_DeploymentLog(null,null,false);&#13;
&#13;
	var grDeployment = new GlideRecord('x_snc_deployer_deployment');&#13;
	grDeployment.initialize();&#13;
	x_snc_devtools.GlideRecordInsert(grDeployment);&#13;
&#13;
	TestCase_DeploymentLog(grDeployment,'Log1','Log1\n');&#13;
	TestCase_DeploymentLog(grDeployment,'Log2','Log1\nLog2\n');&#13;
&#13;
	&#13;
	return test.GetResult();&#13;
	&#13;
})(outputs, steps, stepResult, assertEqual);</value>
