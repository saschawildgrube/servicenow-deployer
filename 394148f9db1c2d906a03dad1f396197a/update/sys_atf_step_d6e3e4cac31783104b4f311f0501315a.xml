				'grInstance': grInstance,
				'strPluginId': strPluginId
			},
			vExpected,
			TestCase_TargetInstancePluginActivate_CheckResult);
	}
		
	TestCase_TargetInstancePluginActivate(null,null,false);
	
	return test.GetResult();
	
})(outputs, steps, stepResult, assertEqual);</value>
