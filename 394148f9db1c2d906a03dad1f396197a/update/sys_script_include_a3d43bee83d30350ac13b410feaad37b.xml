    <sys_script_include action="INSERT_OR_UPDATE">
        <access>package_private</access>
        <active>true</active>
        <api_name>x_snc_deployer.DeploymentLog</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Adds a log message to the given Deployment record. Returns true, if successful, false if not.</description>
        <mobile_callable>false</mobile_callable>
        <name>DeploymentLog</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[function DeploymentLog(vDeployment,vPayload)
{
	var IsValidRecord = x_snc_devtools.IsValidRecord;
	var RecordAppendValue = x_snc_devtools.RecordAppendValue;
	var RenderValue = x_snc_devtools.RenderValue;

	var grDeployment = GetDeploymentRecord(vDeployment);
	if (IsValidRecord(grDeployment) == false)
	{
		return false;
	}
	return RecordAppendValue(
		grDeployment.getRecordClassName(),
		grDeployment.sys_id,
		'log',
		RenderValue(vPayload)+'\n',
		false);
}]]></script>
